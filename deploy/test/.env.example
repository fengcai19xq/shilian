# 复制为 .env 后填写；.env 不入库
# RAGFlow（官方 compose 起在同机，容器名 ragflow-cpu，API 端口 9380）
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
# RAGFlow 页面「API」里生成的 key
RAGFLOW_API_KEY=
RAGFLOW_DEFAULT_DATASET=kb_default

# WeKnora 推送通道（WK10）：INGEST_SINK=weknora 时生效
# 空间级 API Key 需覆盖建库链路：现场实测 scoped key（retrieve+ingest+chat）连
# POST /knowledge-bases 与 GET /models 都是 403，因此这里必须用 full_access key
INGEST_SINK=ragflow
# 文档登记 JSON 快照（重启恢复；不保存原始文件）
INGEST_STORE_PATH=/var/ingest/documents.json
# 原始文件根目录：与 packager 共享同一个卷
INGEST_FILE_STORE_PATH=/var/filestore
# matcher 任务快照 / packager 产物目录（单机测试环境）
MATCHER_STORE_PATH=/var/matcher/store.json
# 成册基础链路：ingest 登记富化 + 本地词面 p(satisfies)；T03 校准前按 pending 为主
MATCHER_ENRICHMENT_ENABLED=true
MATCHER_DECIDE_BACKEND=lexical
PACKAGER_STORAGE_ROOT=/var/filestore
PACKAGER_STORAGE_OUT_DIR=/var/packages
WEKNORA_BASE_URL=
WEKNORA_API_KEY=
WEKNORA_TENANT_ID=
# 服务端解析总超时与轮询间隔（秒）；大 PDF 审计报告需调大
WEKNORA_PARSE_TIMEOUT_SECONDS=600
WEKNORA_PARSE_POLL_SECONDS=5
# 检索侧 KB/标签索引缓存 TTL（秒）；新建库/标签无需重启
WEKNORA_CACHE_TTL_SECONDS=60
# 检索审计 JSONL 落盘目录（容器内挂载点）；不设置则只写内存
AUDIT_LOG_PATH=/var/audit/retrieval.jsonl
# 建 KB 时绑定的向量模型名（INGEST_SINK=weknora 必填，且须与 WeKnora 空间内
# 已配通的 Embedding 模型名一致）。缺失会建出解析必然失败的库，且无法事后补绑
WEKNORA_EMBEDDING_MODEL=

# 模型密钥（测试环境只配 L1/L2 可用的通道；没有则相应模型不可用，网关返回 503）
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_ENTERPRISE_API_KEY=
GATEWAY_QWEN_ENTERPRISE_API_KEY=
GATEWAY_VPC_API_KEY=
# 模型网关用量账本：SQLite 文件，重启不丢预算统计（单机测试环境）
GATEWAY_USAGE_DB_PATH=/var/usage/gateway.sqlite

# 路由判定后端：rule（默认，零成本）| llm
DECIDE_BACKEND=rule
# 企业实体词表（逗号分隔），命中即判为企业问题
DECIDE_ENTITY_VOCAB=航锂,融资部,授信

# PC 工作台对外端口
WEB_PORT=8088

# RAGFlow 官方 compose 创建的网络名（目录名_ragflow，默认 docker_ragflow）
RAGFLOW_NETWORK=docker_ragflow

# 部门 -> RAGFlow 数据集映射见 ingest-application.yml

# BFF：浏览器唯一入口，负责会话 -> principal 注入与权限字段剥离
# 测试环境用服务端固定主体（不是浏览器构建期变量）；生产置 BFF_DEV_MODE=false 并接入身份服务
BFF_DEV_MODE=true
# 过渡模式默认关闭；只有外部网关已完成鉴权且服务不可直连时才置 true
BFF_TRUST_USER_HEADER=false
# 会话 Cookie 名：IdP 把 id_token 放在 HttpOnly Cookie 时，BFF 会转成 Authorization 给 wecom-sync
BFF_SESSION_COOKIE=shilian_id_token
# 允许访问 /api/ingest/*（上传/文档列表）的角色；普通用户走不了管理代理
BFF_ADMIN_ROLES=admin,it_admin
# 检索上下文签名密钥：多副本 BFF 必须共享同一个值；置空则退回单实例内存上下文
# 生成示例：openssl rand -hex 32；不要提交真实密钥
BFF_CONTEXT_SECRET=
BFF_CONTEXT_COOKIE_SECURE=false
BFF_DEV_PRINCIPAL={"user_id":"u_fin","dept":["融资部"],"roles":["it_admin"],"max_sensitivity":"L2","projects":[]}
# 注：测试主体带 it_admin 仅为允许走 /api/ingest 上传；生产角色来自 wecom-sync 授权表
# 检索范围由服务端决定，浏览器不能自行扩大；按部门数据集配置
BFF_KB_SCOPE=kb_finance,kb_audit
# 可选：BFF 与内部服务共享的调用令牌（当前服务端为兼容旧部署默认不校验）
BFF_INTERNAL_TOKEN=

# 管理端点令牌：/identity/sync、/grants、/principal/{id} 等必须带 X-Admin-Token
# 默认强制；未配置时这些端点 403（/identity/me 不受影响）
IDENTITY_REQUIRE_ADMIN_TOKEN=true
IDENTITY_ADMIN_TOKEN=

# 生产统一登录：BFF_DEV_MODE=false 时由 wecom-sync 验签 id_token 并返回 principal
# HS256 内网自签 / RS256 IdP 公钥，按实际环境配置；任何真实密钥都不要提交
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_ALGORITHM=HS256
OIDC_HMAC_SECRET=
OIDC_PUBLIC_KEY_PEM=

# BFF 内部下游（compose 服务名，一般不暴露给浏览器）
BFF_MATCHER_URL=http://matcher:8010
BFF_PACKAGER_URL=http://packager:8080

# MCP Server 端点（WK15）：把知识库对外发布给 Claude / Cursor 等工具
# 留空则不挂载路由（默认关闭）；配置格式见 contracts/mcp.md
# MCP_RETRIEVAL_URL=http://retrieval-proxy:8000
# MCP_ENDPOINTS=[{"endpoint_id":"finance-search","token":"mcp_sk_xxx","kb_scope":["kb_finance"],"principal":{"user_id":"mcp_finance","dept":["融资部"],"max_sensitivity":"L2","projects":[]},"capabilities":["search"]}]
