# 复制为 .env 后填写；.env 不入库
# RAGFlow（官方 compose 起在同机，容器名 ragflow-cpu，API 端口 9380）
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
# RAGFlow 页面「API」里生成的 key
RAGFLOW_API_KEY=
RAGFLOW_DEFAULT_DATASET=kb_default

# 模型密钥（测试环境只配 L1/L2 可用的通道；没有则相应模型不可用，网关返回 503）
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_ENTERPRISE_API_KEY=
GATEWAY_QWEN_ENTERPRISE_API_KEY=
GATEWAY_VPC_API_KEY=

# 路由判定后端：rule（默认，零成本）| llm
DECIDE_BACKEND=rule
# 企业实体词表（逗号分隔），命中即判为企业问题
DECIDE_ENTITY_VOCAB=航锂,融资部,授信

# PC 工作台对外端口
WEB_PORT=8088

# RAGFlow 官方 compose 创建的网络名（目录名_ragflow，默认 docker_ragflow）
RAGFLOW_NETWORK=docker_ragflow

# 部门 -> RAGFlow 数据集映射见 ingest-application.yml
