# Lite 形态环境变量：复制为 .env 后填写
# 用法：cp deploy/test/lite.env.example .env && docker compose -f docker-compose.lite.yml up -d

# ---- WeKnora 底座（检索 + 解析）----
# WeKnora 可在本机 docker 起或远程部署；填宿主可达地址
WEKNORA_BASE_URL=http://weknora:8080
# 空间级 full_access API Key（retrieve + ingest + chat）
WEKNORA_API_KEY=
WEKNORA_TENANT_ID=
# KB/标签索引缓存 TTL（秒）
WEKNORA_CACHE_TTL_SECONDS=60
# 服务端解析总超时与轮询间隔（秒）
WEKNORA_PARSE_TIMEOUT_SECONDS=600
WEKNORA_PARSE_POLL_SECONDS=5
# 建 KB 时绑定的向量模型名（必填，须与 WeKnora 空间内已配通的 Embedding 模型名一致）
WEKNORA_EMBEDDING_MODEL=

# ---- 模型密钥 ----
GATEWAY_DEEPSEEK_API_KEY=
GATEWAY_DEEPSEEK_ENTERPRISE_API_KEY=
GATEWAY_QWEN_ENTERPRISE_API_KEY=
GATEWAY_VPC_API_KEY=

# ---- 路由判定 ----
DECIDE_BACKEND=rule
DECIDE_ENTITY_VOCAB=航锂,融资部,授信

# ---- OIDC 身份源（Lite 形态必须配置，不再用 BFF_DEV_MODE）----
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=shilian
# RS256（推荐）：填 IdP 公钥 PEM；HS256：填共享密钥
OIDC_ALGORITHM=RS256
OIDC_PUBLIC_KEY_PEM=
OIDC_HMAC_SECRET=

# ---- 管理端点令牌 ----
IDENTITY_REQUIRE_ADMIN_TOKEN=true
IDENTITY_ADMIN_TOKEN=

# ---- BFF ----
BFF_SESSION_COOKIE=shilian_id_token
BFF_ADMIN_ROLES=admin,it_admin
BFF_KB_SCOPE=kb_finance,kb_audit
BFF_CONTEXT_SECRET=
BFF_CONTEXT_COOKIE_SECURE=false

# ---- PC 工作台端口 ----
WEB_PORT=8088

# ---- MCP Server（可选，默认关闭）----
# MCP_ENDPOINTS=[{"endpoint_id":"finance-search","token":"mcp_sk_xxx","kb_scope":["kb_finance"],"principal":{"user_id":"mcp_finance","dept":["融资部"],"max_sensitivity":"L2","projects":[]},"capabilities":["search"]}]
