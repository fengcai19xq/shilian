# 复制为 .env.local 后按需填写；.env.local 已被 .gitignore 忽略，不要提交真实地址或身份信息

# 接口模式：mock（默认，写死示例数据）| http（经 dev proxy 访问真实服务）
VITE_API_MODE=mock
# 前端请求前缀（默认 /api）
VITE_API_BASE=/api

# 开发代理目标（仅 vite dev 使用，不会打进前端产物）
DECIDE_URL=http://127.0.0.1:<decide-port>
RETRIEVAL_URL=http://127.0.0.1:<retrieval-port>
GATEWAY_URL=http://127.0.0.1:<gateway-port>
IDENTITY_URL=http://127.0.0.1:8020

# WeKnora 平台管理面外链（留空则不显示入口；问答仍在本工作台）
VITE_WEKNORA_CONSOLE_URL=

# 身份来源（WK17）：默认从 /api/identity/me 取服务端会话主体，前端不自报身份。
# 下面两项仅供本地联调，生产环境必须留空 —— 一旦注入，前端产物会固化该身份。
VITE_USER_ID=
# 例：{"user_id":"u_xxxxx","dept":["示例部门"],"roles":[],"max_sensitivity":"L2","projects":[]}
VITE_DEV_PRINCIPAL=
